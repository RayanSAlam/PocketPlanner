# Copy this to .env for local dev. In Vercel, set these under
# Project Settings -> Environment Variables instead (this file itself is
# never read in production — Vite only inlines vars present at build time).

VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon/publishable-key"

# Optional — omit to use the built-in heuristic budget-insights engine
# (no API key needed). See README's Budgeting feature section.
# VITE_ENABLE_AI_INSIGHTS="true"
